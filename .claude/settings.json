{
  "permissions": {
    "allow": [
      "Bash(pwsh -NoProfile -File scripts/ci-local.ps1:*)",
      "Bash(python3 scripts/check_skill_prompt_references.py)",
      "Bash(python3 scripts/render_task_counts.py)",
      "Bash(python3 scripts/render_claude_manifest.py)",
      "Bash(python3 scripts/measure_process.py)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Edit(requirements.txt)",
      "Write(requirements.txt)",
      "Edit(requirements.lock)",
      "Write(requirements.lock)",
      "Edit(engine.ref)",
      "Write(engine.ref)",
      "Edit(pyproject.toml)",
      "Write(pyproject.toml)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git status --short --branch"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_tool_use.py\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
