@startuml 01_as_is_component
' EPIC-007 — Hiện trạng (đo 2026-08-24 bằng engine's widgets.guards + grep, không ước lượng)
' Mỗi con số trong file này đều lấy từ mã nguồn thật, xem PHỤ LỤC cuối file.

title EPIC-007 — HIỆN TRẠNG: mỗi màn hình tự đẻ card riêng

skinparam componentStyle rectangle
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam ArrowFontSize 11

legend top left
  |= Ký hiệu |= Ý nghĩa |
  | <b>[QFrame]</b> | kế thừa thẳng lớp Qt gốc — guard <i>find_bare_qt_base_widgets</i> báo lỗi |
  | <b>#hex</b> | tự chế màu trong file, không đọc token |
  | <b>(0)</b> | số consumer thật trong Elite |
endlegend

package "Sagittarius_Engine :: pyside_mvc.widgets" as ENGINE #E8F0FE {
  component "Surface (abstract)" as E_Surface #FFCDD2
  component "Card  (title + header_actions + body)" as E_Card #FFCDD2
  component "Panel (không header)" as E_Panel #FFCDD2
  component "SelectableCard" as E_SelCard #C8E6C9
  component "Overlay (QDialog)" as E_Overlay #C8E6C9
  component "StyledButton" as E_Btn #FFCDD2
  component "StyledCheckBox" as E_Chk #C8E6C9
  component "StyledField / DateTimeField" as E_Field #FFCDD2
  component "apply_role() + StyleRole\nSURFACE · SELECTABLE_CARD · FIELD\nPRIMARY/SECONDARY/DANGER_BUTTON · CHECKBOX" as E_Style #FFF9C4

  note right of E_Card
    <b>0 consumer.</b> Card/Panel/Surface/StyledButton/
    StyledField/DateTimeField chưa từng được
    Elite dùng một lần nào — nửa "Surface" của
    EPIC-006B ship xong rồi nằm không.
    <b>Không có StyleRole cho BADGE / BANNER /</b>
    <b>SECTION_LABEL</b> — 3 hình dạng bị lặp nhiều nhất.
  end note
}

package "Elite :: screens/dashboard (Dev Board)" as SC_DASH #FFF3E0 {
  component "DashboardView (BaseView)" as D_View
  component "DevBoardPanel [QWidget]\n8 hằng hex riêng · _card_style()\n22 × setStyleSheet" as D_Panel #FFE0B2
