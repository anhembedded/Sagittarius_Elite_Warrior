# GENERATED by scripts/render_service_files.py - do not edit; a guard compares this file
# with the generator. The runbook is Docs/OPERATIONS/headless_runbook.md.
#
# NOT supported for unattended money until EPIC-036B has merged. A bot that halts, errs or
# whose stop gives up reaches Discord when the alerting_discord_webhook credential holds a
# webhook (EPIC-036G); a host that dies or powers off reaches the owner when the
# alerting_deadman_ping_url credential holds a check-in URL (EPIC-036E1).
#
# TimeoutStopSec = ceil(--stop-timeout + STOP_GRACE_SECONDS + LEAVE_PUBLISH_SECONDS) + margin
#               = ceil(25 + 30 + 2) + 5 = 62 s
# The host leaves by itself after 57 s at the latest (the stop policy under --stop-timeout,
# the rest of the stop under STOP_GRACE_SECONDS, then at most LEAVE_PUBLISH_SECONDS for the last
# snapshot); systemd must not send SIGKILL before that. If you change --stop-timeout, regenerate.
#
# RestartPreventExitStatus is every code Docs/OPERATIONS/exit_codes.md marks "not restarted":
# a configuration or lock failure that a restart would only repeat (a rejected key repeated is
# an IP ban waiting to happen).

[Unit]
Description=Sagittarius Elite Warrior - run the bots with no window
Documentation=https://github.com/anhembedded/Sagittarius_Elite_Warrior/blob/master-warrior/Docs/OPERATIONS/headless_runbook.md
After=network-online.target
Wants=network-online.target
# Restart as often as it takes: the exit codes, not a start limit, decide what is not retried.
StartLimitIntervalSec=0

[Service]
# `--host-signal sdnotify` sends READY=1 once the host serves (after the pre-flight and the
# restore), so a start that dies in the pre-flight is a failed start, not an active unit.
# Does not work in a container that does not mount systemd's notify socket.
Type=notify
User=sew
Group=sew
WorkingDirectory=/var/lib/sew
Environment=PYTHONPATH=/opt/sew
Environment=SEW_DATA_ROOT=/var/lib/sew
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Optional testnet keys (BINANCE_*_TESTNET_API_KEY / _SECRET), root:sew mode 0640.
EnvironmentFile=-/etc/sew/sew.env
# Secrets: every file in /etc/sew/credentials/ (subdirectories too) becomes a credential named sew_<file>, read as
# $CREDENTIALS_DIRECTORY/sew_<file>. One line for the directory, not one per file: systemd refuses
# to start a unit whose LoadCredential= names a file that is missing (243/CREDENTIALS), and a
# directory loads whatever it holds. A file you have not created is a secret that is not set:
# the venue or the feature is off and the host starts. The directory itself must exist.
#   mainnet keys: futures_mainnet_api_key, futures_mainnet_api_secret, spot_mainnet_api_key, spot_mainnet_api_secret
#   alerts: alerting_discord_webhook, alerting_deadman_ping_url, alerting_telegram_bot_token, alerting_telegram_chat_id (the Discord webhook; the dead man's switch's check-in URL; the Telegram bot token and chat id)
# An empty file reads as not set too. The host warns at start when no channel carries bot events.
LoadCredential=sew:/etc/sew/credentials
# No log.file, no --dev, no --debug: the log is stdout, and the journal bounds it.
ExecStart=/opt/sew/venv/bin/python /opt/sew/Sagittarius_Elite_Warrior/src/main.py run --stop-timeout 25 --health-interval 60 --on-stop leave-orders --host-signal sdnotify
Restart=on-failure
RestartSec=10
RestartPreventExitStatus=2 3 4 5
TimeoutStartSec=300
TimeoutStopSec=62
MemoryMax=1G

# The host writes only its data root (state/, logs/, the bots' files). StateDirectory= creates
# it, owned by User=, and stays writable under ProtectSystem=strict; everything else is read-only.
StateDirectory=sew
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
# AF_UNIX is the notify socket; the exchange needs AF_INET and AF_INET6.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
