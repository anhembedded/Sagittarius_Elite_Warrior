' Question: which component calls which, and across which port?
' Explained by: ../05-building-blocks.md, which cites each component. Drawn by hand, high level.
' An arrow's label is the port it crosses; the box at its head implements it.
@startuml 05-components
skinparam componentStyle rectangle
top to bottom direction

package "application" {
  [BotAlertSource] as S
  [AlertHub] as H
  [ChannelDelivery] as CD
  [SendTestMessage] as ST
  [ChannelAlertingStatus] as CS
}
package "adapters" {
  [InMemoryAlertSettings] as SET
  [SqliteOutbox] as O
  [ThreadedDeliveryHost] as T
  [RegisteredChannelCatalog] as C
  [DiscordWebhookChannel] as D
  [UrllibWebhookTransport] as U
}

S --> H : IAlertPublisher\npublish, condition_cleared
H --> SET : IAlertSettingsSource
H --> O : IOutbox\nenqueue (one transaction)
T --> CD : run_due\n(one lane per channel)
CD --> O : IOutbox\ndue, mark
CD --> D : IAlertChannel\ndeliver
CD ..> H : IDeliveryFollowUp\nchannel_failing, fail_over
C --> D : holds each\nconfigured channel
D --> U : IWebhookTransport\npost_json
CS --> C : in the catalog\nand not disabled
ST --> C : one TEST alert per channel,\nnever the outbox
@enduml
