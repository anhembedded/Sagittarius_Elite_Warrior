{
  "CLI_COMMANDS": {
    "sync": {
      "help": "Synchronize market data from Binance",
      "args": [
        {
          "name": "--symbols",
          "type": "str",
          "required": true,
          "help": "Comma separated list of symbols"
        },
        {
          "name": "--interval",
          "type": "str",
          "default": "1m",
          "help": "Timeframe interval",
          "choices": ["1s", "1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "8h", "12h", "1d", "3d", "1w", "1M"]
        },
        {
          "name": "--days",
          "type": "int",
          "default": 30,
          "help": "Days back to sync"
        }
      ]
    },
    "stream": {
      "help": "Manage live websocket market stream",
      "subparsers": {
        "dest": "action",
        "commands": {
          "start": {
            "help": "Start live stream",
            "args": [
              {
                "name": "--symbols",
                "type": "str",
                "required": true,
                "help": "Comma-separated symbols"
              },
              {
                "name": "--interval",
                "type": "str",
                "required": true,
                "help": "Timeframe interval",
                "choices": ["1s", "1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "8h", "12h", "1d", "3d", "1w", "1M"]
              }
            ]
          },
          "stop": {
            "help": "Stop live stream"
          }
        }
      }
    }
  }
}