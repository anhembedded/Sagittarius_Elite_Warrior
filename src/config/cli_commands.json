{
  "CLI_COMMANDS": {
    "sync": {
      "help": "Synchronize market data from Binance",
      "args": [
        {
          "name": "--symbols",
          "type": "str",
          "required": true,
          "help": "Comma separated list of symbols"
        },
        {
          "name": "--interval",
          "type": "str",
          "default": "1m",
          "help": "Timeframe interval",
          "choices": ["1s", "1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "8h", "12h", "1d", "3d", "1w", "1M"]
        },
        {
          "name": "--days",
          "type": "int",
          "default": 30,
          "help": "Days back to sync"
        }
      ]
    },
    "stream": {
      "help": "Manage live websocket market stream",
      "subparsers": {
        "dest": "action",
        "commands": {
          "start": {
            "help": "Start live stream",
            "args": [
              {
                "name": "--symbols",
                "type": "str",
                "required": true,
                "help": "Comma-separated symbols"
              },
              {
                "name": "--interval",
                "type": "str",
                "required": true,
                "help": "Timeframe interval",
                "choices": ["1s", "1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "8h", "12h", "1d", "3d", "1w", "1M"]
              }
            ]
          },
          "stop": {
            "help": "Stop live stream"
          }
        }
      }
    },
    "exchange-status": {
      "help": "Check Futures Testnet connection: signature, clock skew, balance, position mode"
    },
    "order-preview": {
      "help": "Preview a normalized live order (rounding + minNotional check) without sending it",
      "args": [
        {
          "name": "--symbol",
          "type": "str",
          "required": true,
          "help": "Futures symbol, e.g. BTCUSDT"
        },
        {
          "name": "--side",
          "type": "str",
          "required": true,
          "help": "Order side",
          "choices": ["BUY", "SELL"]
        },
        {
          "name": "--qty",
          "type": "str",
          "required": true,
          "help": "Requested quantity (decimal string, e.g. 0.0137)"
        },
        {
          "name": "--type",
          "type": "str",
          "default": "MARKET",
          "help": "Order type",
          "choices": ["MARKET", "LIMIT", "STOP_MARKET", "TAKE_PROFIT_MARKET"]
        },
        {
          "name": "--price",
          "type": "str",
          "required": true,
          "help": "Reference price for the notional estimate (decimal string) — required: this task has no live mark-price network path"
        },
        {
          "name": "--json",
          "action": "store_true",
          "help": "Print the normalized domain Order as JSON instead of the text report"
        }
      ]
    },
    "order-dry-run": {
      "help": "Send a normalized order to POST /fapi/v1/order/test — validates signature, permissions and payload, creates nothing",
      "args": [
        {
          "name": "--symbol",
          "type": "str",
          "required": true,
          "help": "Futures symbol, e.g. BTCUSDT"
        },
        {
          "name": "--side",
          "type": "str",
          "required": true,
          "help": "Order side",
          "choices": ["BUY", "SELL"]
        },
        {
          "name": "--qty",
          "type": "str",
          "required": true,
          "help": "Requested quantity (decimal string, e.g. 0.002)"
        },
        {
          "name": "--type",
          "type": "str",
          "default": "MARKET",
          "help": "Order type",
          "choices": ["MARKET", "LIMIT", "STOP_MARKET", "TAKE_PROFIT_MARKET"]
        },
        {
          "name": "--price",
          "type": "str",
          "required": true,
          "help": "Reference price for the notional estimate (decimal string) — required: this task has no live mark-price network path"
        }
      ]
    },
    "trade-once": {
      "help": "Run one strategy evaluation and, if actionable, attempt one order through the full safety pipeline. DRY-RUN unless --live is passed. Not a daemon — runs one round and exits",
      "args": [
        {
          "name": "--symbol",
          "type": "str",
          "required": true,
          "help": "Futures symbol, e.g. BTCUSDT"
        },
        {
          "name": "--interval",
          "type": "str",
          "required": true,
          "help": "Timeframe interval",
          "choices": ["1m", "3m", "5m", "15m", "30m", "1h", "2h", "4h", "6h", "8h", "12h", "1d", "3d", "1w", "1M"]
        },
        {
          "name": "--strategy",
          "type": "str",
          "required": true,
          "help": "Registered strategy key",
          "choices": [
            "ema_crossover",
            "multi_ema_trend_follower",
            "support_resistance",
            "ema_trend_confirm_pullback",
            "long_term_trend_zone",
            "volume_spike_flow"
          ]
        },
        {
          "name": "--live",
          "action": "store_true",
          "help": "Actually submit the order (POST /fapi/v1/order). Without this flag, stops after showing the decision — no order-submission network call at all"
        }
      ]
    }
  }
}