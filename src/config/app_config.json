{
    "database.dir": "Sagittarius_Elite_Warrior/database",
    "BINANCE_WS_URL": "wss://stream.binance.com:9443",
    "BINANCE_REST_URL": "https://api.binance.com",
    "LOG_FORMAT": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "log.level": "INFO",
    "log.console.enabled": true,
    "log.viewer.enabled": false,
    "log.viewer.host": "127.0.0.1",
    "log.viewer.port": 9999,
    "log.viewer.module": "binance-bot",
    "binance.rate_limit_delay_ms": 500,
    "backtest.log_max_entries": 6000,
    "dev.mode": false
}
