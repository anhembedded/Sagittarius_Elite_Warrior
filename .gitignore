# Custom Database for Sagittarius_Elite_Warrior
# BUG-077: was unanchored `database/` (no leading slash), which git matches
# against a directory named "database" at ANY depth — it was silently
# swallowing src/application/use_cases/database/ and
# tests/unit/application/use_cases/database/ (real, tracked source
# directories) into "ignored" status. `/database/` below already anchors the
# rule to the repo-root runtime SQLite data directory, which is the only
# thing this was ever meant to ignore.
/database/
*.db
*.db-shm
*.db-wal
Sagittarius_Elite_Warrior/

# Dev-mode session logs (app_bootstrapper --dev)
logs/

# EPIC-010 -- remembered UI state (state/ui_state.json). Never committed:
# it is per-machine memory, not project source. Anchored to the repo root
# ("/state/", not "state/") -- an unanchored pattern also matches
# src/presentation/ui/state/, which is source code, not data.
/state/

# EPIC-021B -- exchange API key/secret fallback file (SecretsFileSource).
# Never committed, unlike user_config.json which stays git-tracked but no
# longer holds credentials (BUG-080). Full path, not a bare filename -- an
# unanchored "secrets.local.json" would also be correct here (the name is
# specific enough not to collide with anything else), but the full path
# makes the one file this ignores unambiguous to a reader.
src/config/secrets.local.json

# Documentation site builds (MkDocs)
site/
Tasks/dashboard.html
